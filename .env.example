# 复制为 .env 后填写。.env 已被 .gitignore 忽略。
# 规则：API key 只能出现在这里，绝不允许写进 config/config.yaml。

# 云端 ASR（仅当 transcription.provider = openai 且 privacy.allow_cloud_audio = true 时需要）
OPENAI_API_KEY=

# Phase 2 的 LLM（笔记整理）
ANTHROPIC_API_KEY=
# 也可复用 OPENAI_API_KEY

